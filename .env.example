# Required in production (NODE_ENV=production, e.g. on Netlify).
# Without these set to non-default values, /api/admin/login returns
# "Admin security is not configured for production." See lib/adminAuth.ts.

# Admin login username
ADMIN_USERNAME=

# Admin login password
ADMIN_PASSWORD=

# Long random session token used for the admin auth cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_TOKEN=
